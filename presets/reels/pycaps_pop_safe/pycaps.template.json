{
    "css": "styles.css",
    "resources": "resources",
    "layout": {
        "max_width_ratio": 0.8,
        "max_number_of_lines": 2,
        "min_number_of_lines": 1,
        "vertical_align": {
            "align": "center",
            "offset": 0.18
        },
        "on_text_overflow_strategy": "exceed_width"
    },
    "splitters": [
        {
            "type": "limit_by_chars",
            "min_chars": 6,
            "max_chars": 16
        }
    ],
    "animations": [
        {
            "type": "zoom_in_primitive",
            "when": "narration-starts",
            "what": "word",
            "duration": 0.18,
            "init_scale": 0.6,
            "overshoot": {
                "amount": 0.08,
                "peak_at": 0.7
            }
        },
        {
            "type": "fade_in",
            "when": "narration-starts",
            "what": "segment",
            "duration": 0.15
        },
        {
            "type": "fade_out",
            "when": "narration-ends",
            "what": "segment",
            "duration": 0.15
        }
    ]
}